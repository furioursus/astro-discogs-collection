# Your Discogs username (the collection this site will render).
DISCOGS_USERNAME=your-discogs-username

# A Discogs Personal Access Token.
# Generate one at: https://www.discogs.com/settings/developers
# This is enough for reading your OWN collection/wantlist — no full OAuth needed.
DISCOGS_TOKEN=your-personal-access-token

# Sent as the User-Agent header on every Discogs API request, as required by
# their API terms. Change the URL to point at your own repo/site.
DISCOGS_USER_AGENT=AstroDiscogsCrate/0.1 +https://github.com/furioursus/astro-discogs-crate
