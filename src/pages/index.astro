---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecordCard from '../components/RecordCard.astro';
import CrateFilter from '../components/CrateFilter.astro';
import { fetchCollection, discogsOptionsFromEnv } from '../lib/discogs';

// Fetched once, at build time — this becomes static HTML with no runtime
// call to Discogs. Rebuild the site to pick up new additions.
const releases = await fetchCollection(discogsOptionsFromEnv());
---

<BaseLayout title="My Vinyl Collection">
  <h1>Collection</h1>
  <p class="count">{releases.length} record{releases.length === 1 ? '' : 's'}</p>

  <CrateFilter />

  <div class="grid" id="crate-grid">
    {releases.map((release) => (
      <RecordCard release={release} />
    ))}
  </div>
</BaseLayout>

<style>
  .count {
    color: var(--muted);
    margin-top: -0.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: 0.9rem;
  }
</style>
