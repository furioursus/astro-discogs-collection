---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A vinyl collection, pulled from Discogs.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Discogs Crate</a>
      <nav>
        <a href="/">Collection</a>
        <a href="/wantlist">Wantlist</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Data from <a href="https://www.discogs.com" rel="noopener">Discogs</a>, fetched at build time.</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fafaf9;
    --fg: #18181b;
    --muted: #71717a;
    --border: #e4e4e7;
    --accent: #b45309;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0a09;
      --fg: #fafaf9;
      --muted: #a1a1aa;
      --border: #27272a;
      --accent: #f59e0b;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
  }

  a {
    color: inherit;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .site-header .brand {
    font-weight: 700;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .site-header nav {
    display: flex;
    gap: 1.25rem;
  }

  .site-header nav a {
    text-decoration: none;
    color: var(--muted);
  }

  .site-header nav a:hover {
    color: var(--fg);
  }

  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .site-footer {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
