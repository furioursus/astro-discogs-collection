---
// A tiny vanilla-JS filter box. No UI framework needed for something this
// small — keeps the site at zero shipped framework JS.
---

<input
  type="search"
  id="crate-filter"
  class="crate-filter"
  placeholder="Filter by artist or title…"
  aria-label="Filter records by artist or title"
/>

<script>
  const input = document.getElementById('crate-filter') as HTMLInputElement | null;
  const grid = document.getElementById('crate-grid');

  if (input && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-artist]'));

    input.addEventListener('input', () => {
      const query = input.value.trim().toLowerCase();
      for (const card of cards) {
        const haystack = `${card.dataset.artist ?? ''} ${card.dataset.title ?? ''}`;
        card.hidden = query.length > 0 && !haystack.includes(query);
      }
    });
  }
</script>

<style>
  .crate-filter {
    width: 100%;
    max-width: 24rem;
    padding: 0.6rem 0.85rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    background: var(--bg);
    color: var(--fg);
    font-size: 0.95rem;
  }
</style>
