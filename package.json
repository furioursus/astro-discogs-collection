{
  "name": "astro-discogs-collection",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Astro integration for browsing a Discogs record collection/wantlist, fetched from the Discogs API at build/dev time.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./client": "./dist/client.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/client.d.ts dist/client.d.ts"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "astro": "^7.1.6",
    "typescript": "^5.6.3"
  }
}
